# Oracle connection (python-oracledb "thin" mode - no Oracle Instant Client needed)
ORACLE_USER=your_username
ORACLE_PASSWORD=your_password
ORACLE_HOST=your_host
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=your_service_name

# Anthropic API key, used to turn plain-English questions into SQL
ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional: restrict schema introspection to one owner/schema (defaults to the connected user)
# ORACLE_SCHEMA=YOUR_SCHEMA
